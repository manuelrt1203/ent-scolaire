{
  "name": "ent-scolaire",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "desktop": "npm run dev --workspace=apps/desktop",
    "web": "npm run dev --workspace=apps/web",
    "types:generate": "echo 'Types générés via Supabase MCP dans packages/shared/src/types/database.types.ts'",
    "test:workflow": "node --require ./scripts/ws-polyfill.cjs scripts/test-workflow.mjs",
    "db:backup": "bash scripts/backup-db.sh"
  },
  "devDependencies": {
    "ws": "^8.18.0"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "@types/react": "~19.1.10"
  }
}
