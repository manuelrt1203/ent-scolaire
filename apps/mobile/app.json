{
  "expo": {
    "name": "ENT Scolaire",
    "slug": "ent-scolaire-mobile",
    "scheme": "entscolaire",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.entscolaire.mobile"
    },
    "android": {
      "package": "fr.entscolaire.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3098407d-f05d-43bb-bcc5-a4449fd25410"
      }
    },
    "owner": "manuel1203"
  }
}
